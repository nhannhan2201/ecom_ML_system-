# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# E-Commerce Real-Time Purchase Propensity Prediction System
# Copy this file to .env (and/or docker/.env) for local development
# Note: Values below are local dev defaults (CHANGE_ME for production)
# ==============================================================================

# --- Python & Java Runtimes ---
PYTHON_BIN=python
# JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64

# --- MinIO S3 Object Storage (Lakehouse) ---
# Host access endpoint: http://localhost:9000
# Container-to-container internal endpoint: http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_RAW_BUCKET=ecommerce-raw
MINIO_LAKEHOUSE_BUCKET=ecommerce-lakehouse
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL DWH (Star Schema) ---
POSTGRES_DWH_HOST=localhost
POSTGRES_DWH_PORT=5432
POSTGRES_DWH_DB=ecom_dwh
POSTGRES_DWH_USER=postgres
POSTGRES_DWH_PASSWORD=postgres

# --- Redis (Feast Online Store) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=ecommerce_stream_events

# --- Apache Airflow ---
AIRFLOW_UID=1000
AIRFLOW_PROJ_DIR=.
AIRFLOW_POSTGRES_PORT=5433
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_WEBSERVER_PORT=8080

# --- Apache Flink ---
FLINK_JOBMANAGER_HOST=localhost
FLINK_REST_PORT=8081

# --- DataHub Platform ---
DATAHUB_VERSION=v1.6.0
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=CHANGE_ME_BASE64_32BYTE_KEY_FOR_PROD
DATAHUB_TOKEN_SERVICE_SALT=CHANGE_ME_BASE64_32BYTE_SALT_FOR_PROD
DATAHUB_SYSTEM_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET
DATAHUB_MYSQL_PASSWORD=datahub
DATAHUB_NEO4J_PASSWORD=datahub
DATAHUB_MAPPED_GMS_PORT=8089
DATAHUB_MAPPED_FRONTEND_PORT=9002
DATAHUB_MAPPED_KAFKA_PORT=9093
DATAHUB_GMS_URL=http://localhost:8089
