# ==============================================================================
# MULTISTAGE OPTIMIZED DOCKERFILE AIRFLOW WITH PYSPARK, DELTA LAKE & FEAST
# Project: E-Commerce Real-Time Purchase Propensity Prediction System
#
# Optimization Techniques:
#   1. Multistage build pattern: builder stage compiles/installs Python dependencies
#   2. Headless JRE only (openjdk-11-jre-headless) instead of full JDK
#   3. Minimal OS packages with --no-install-recommends
#   4. Aggressive apt cleanup (autoremove, clean, rm /var/lib/apt/lists/*)
#   5. Pinned dependency requirements copied into builder
#   6. Zero pip wheel cache (--no-cache-dir) and clean layer copy
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder (Python dependency resolver & wheel installer)
# ------------------------------------------------------------------------------
FROM apache/airflow:2.7.3-python3.10 as builder

USER airflow

# Copy isolated requirements file for caching layer reuse
COPY --chown=airflow:root docker/requirements-airflow.txt /tmp/requirements-airflow.txt

# Install dependencies into user site directory without caching wheels
RUN pip install --no-cache-dir --user -r /tmp/requirements-airflow.txt

# ------------------------------------------------------------------------------
# Stage 2: Final Runtime Image
# ------------------------------------------------------------------------------
FROM apache/airflow:2.7.3-python3.10

USER root

# Install minimal OpenJDK 11 Headless & procps with aggressive cache purge
RUN rm -rf /etc/apt/sources.list.d/* && \
    echo "deb [trusted=yes] http://archive.debian.org/debian bullseye main" > /etc/apt/sources.list && \
    apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --no-install-recommends \
        openjdk-11-jre-headless \
        procps && \
    apt-get autoremove -yqq --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Configure standard JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Copy built Python artifacts from builder stage (zero compiler residue, zero pip cache)
COPY --from=builder --chown=airflow:root /home/airflow/.local /home/airflow/.local
