# ==============================================================================
# SINGLE-STAGE CLEAN DOCKERFILE AIRFLOW (Clean without multistage)
# ==============================================================================
FROM apache/airflow:2.7.3-python3.10

USER root

# Install minimal OpenJDK 11 Headless & procps with aggressive cache purge
RUN rm -rf /etc/apt/sources.list.d/* && \
    echo "deb [trusted=yes] http://archive.debian.org/debian bullseye main" > /etc/apt/sources.list && \
    apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y --no-install-recommends \
        openjdk-11-jre-headless \
        procps && \
    apt-get autoremove -yqq --purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Install dependencies directly with --no-cache-dir (single stage)
COPY --chown=airflow:root docker/requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt
